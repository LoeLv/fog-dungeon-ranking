<view class="page battle-page {{canManageBattle ? 'battle-mode-dm' : 'battle-mode-player'}} {{canManageBattle ? activeDmPage : 'player-field'}}">
  <view wx:if="{{loading}}" class="section empty">正在读取战斗房间...</view>

  <block wx:else>
    <view wx:if="{{errorMessage}}" class="section empty error">{{errorMessage}}</view>

    <view wx:if="{{room}}" class="section battle-topbar panel">
      <view>
        <text class="kicker">PUBLIC BATTLEFIELD</text>
        <text class="title">{{dungeon.name || '未命名试炼'}}</text>
        <text class="muted">{{room.roundLabel}} · {{room.statusLabel}} · DM {{room.host_name || '未记录'}}</text>
        <text wx:if="{{room.expiresNote && room.room_status === 'active'}}" class="muted">{{room.expiresNote}}</text>
      </view>
      <view class="hero-actions">
        <button class="mini-action" loading="{{refreshing}}" bindtap="loadBattle">刷新</button>
        <button class="mini-action" bindtap="continueBattle">继续</button>
        <button wx:if="{{canJoin}}" class="mini-action" loading="{{actionLoading}}" bindtap="joinBattle">加入</button>
      </view>
    </view>

    <view wx:if="{{room}}" class="section battle-overview compact-overview">
      <view wx:for="{{overviewCards}}" wx:key="label" class="overview-card">
        <text class="overview-label">{{item.label}}</text>
        <text class="overview-value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{!canManageBattle || activeDmPage === 'field'}}" class="section panel battle-panel battlefield-panel">
      <view class="battlefield-heading">
        <view>
          <text class="kicker">LIVE FIELD</text>
          <text class="panel-title">战场</text>
          <text class="muted">中央是红队和蓝队，外围是观众席。</text>
        </view>
        <view class="field-counters">
          <text class="field-counter">{{players.length}} 人</text>
          <text class="field-counter">{{room.roundLabel}}</text>
        </view>
      </view>
      <view class="row subhead">
        <text class="panel-title">公开战场信息</text>
        <text class="muted">{{players.length}} 人</text>
      </view>
      <view wx:if="{{!players.length}}" class="empty">暂无战斗成员。</view>
      <view wx:if="{{spectatorPlayers.length}}" class="crowd-strip crowd-top">
        <text class="crowd-label">观战席</text>
        <view class="crowd-list">
          <view wx:for="{{spectatorTopPlayers}}" wx:key="id" class="crowd-chip">{{item.player_name}}</view>
        </view>
      </view>

      <view class="battle-core battlefield-core">
        <view wx:for="{{frontPlayerGroups}}" wx:key="key" class="team-section team-{{item.kind}}">
          <view class="row team-section-head">
            <text class="team-section-title">{{item.label}}</text>
            <text class="pill">{{item.count}} 人</text>
          </view>
          <view wx:if="{{item.isEmpty}}" class="empty compact">这一组还没有人。</view>
          <view wx:for="{{item.players}}" wx:for-item="member" wx:key="id" class="battle-player {{member.is_self ? 'self' : ''}}">
            <view class="row player-head">
              <view>
                <text class="player-name">{{member.player_name}}</text>
                <text class="muted">{{member.classLabel}} · {{member.statusLabel}} · {{member.faithLabel}}</text>
              </view>
              <view class="player-head-meta">
                <text class="pill life-pill life-{{member.lifeTone}}">{{member.lifeLabel}}</text>
                <text class="pill hp-pill hp-{{member.hpTone}}">{{member.hpText}}</text>
              </view>
            </view>
            <view class="hp-track">
              <view class="hp-fill hp-{{member.hpTone}}" style="width: {{member.hpPercent}}%;"></view>
            </view>
            <view class="public-tags">
              <text class="tag team-tag team-{{member.teamKind}}">{{member.teamLabel}}</text>
              <text class="tag">护盾 {{member.shieldText}}</text>
              <text class="tag">攻击 {{member.attack_value || 0}}</text>
              <text class="tag">{{member.faithLabel}}</text>
            </view>
            <view class="status-list">
              <text class="status-empty" wx:if="{{!member.statuses.length}}">暂无状态</text>
              <view wx:for="{{member.statuses}}" wx:for-item="status" wx:key="id" class="status-chip {{status.is_public ? '' : 'private'}}">
                <view class="status-main">
                  <text class="status-name">{{status.status_name}}</text>
                  <text class="status-meta">{{status.stackText}} · {{status.visibleText}}</text>
                </view>
                <view wx:if="{{canManageBattle}}" class="status-tools">
                  <input class="input status-layer-input" type="number" data-id="{{status.id}}" value="{{status.stackInputValue}}" bindinput="onStatusLayerInput" />
                  <button class="mini-action status-button" data-id="{{status.id}}" loading="{{actionLoading}}" bindtap="updateStatusLayer">改</button>
                  <button class="mini-action status-button" data-id="{{status.id}}" data-public="{{status.is_public ? '1' : '0'}}" loading="{{actionLoading}}" bindtap="toggleStatusPublic">{{status.is_public ? '隐藏' : '公开'}}</button>
                  <button class="mini-action status-button danger" data-id="{{status.id}}" loading="{{actionLoading}}" bindtap="deleteStatus">删</button>
                </view>
              </view>
            </view>
            <view wx:if="{{member.abilities.length && !member.is_self}}" class="public-abilities">
              <view wx:if="{{canManageBattle}}" class="ability-fold-head" data-player-id="{{member.id}}" bindtap="togglePlayerAbilities">
                <text class="ability-fold-title">天赋技能 {{member.abilities.length}}</text>
                <text class="ability-fold-action">{{expandedAbilityPlayers[member.id] ? '收起' : '展开'}}</text>
              </view>
              <view wx:if="{{!canManageBattle || expandedAbilityPlayers[member.id]}}" class="ability-fold-body">
              <view
                wx:for="{{member.abilities}}"
                wx:for-item="ability"
                wx:key="key"
                class="public-ability {{ability.ready ? '' : 'disabled'}}"
              >
                <view class="row ability-head">
                  <view>
                    <text class="ability-name">{{ability.displayName}}</text>
                    <text class="muted">{{ability.detail}}</text>
                  </view>
                  <view class="ability-side">
                    <text class="pill">{{ability.cooldownLabel}}</text>
                    <button
                      wx:if="{{canOperate}}"
                      class="mini-action cooldown-button"
                      data-player-id="{{member.id}}"
                      data-key="{{ability.key}}"
                      loading="{{cooldownLoadingKey === ability.cooldownActionKey}}"
                      bindtap="putAbilityOnCooldown"
                    >冷却</button>
                  </view>
                </view>
              </view>
              </view>
            </view>
            <text wx:if="{{member.publicNote}}" class="muted player-note">{{member.publicNote}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{reservePlayerGroups.length}}" class="reserve-strip">
        <view wx:for="{{reservePlayerGroups}}" wx:key="key" class="reserve-group">
          <view class="row team-section-head">
            <text class="team-section-title">{{item.label}}</text>
            <text class="pill">{{item.count}} 人</text>
          </view>
          <view wx:if="{{item.isEmpty}}" class="empty compact">这一组还没有人。</view>
          <view wx:for="{{item.players}}" wx:for-item="member" wx:key="id" class="reserve-chip">{{member.player_name}}</view>
        </view>
      </view>

      <view wx:if="{{spectatorPlayers.length}}" class="crowd-strip crowd-bottom">
        <text class="crowd-label">观战席</text>
        <view class="crowd-list">
          <view wx:for="{{spectatorBottomPlayers}}" wx:key="id" class="crowd-chip">{{item.player_name}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!canManageBattle}}" class="section panel player-action-panel">
      <view class="row subhead">
        <text class="panel-title">我的行动卡</text>
        <text class="muted">{{selfPlayer ? selfPlayer.player_name : '未入场'}}</text>
      </view>
      <view wx:if="{{!selfPlayer}}" class="empty">你还不是这个战斗房间成员，只能查看公开战场。</view>
      <block wx:else>
        <view class="self-banner">
          <view>
            <text class="self-stat">{{selfPlayer.hpText}}</text>
            <text class="muted">{{selfPlayer.teamLabel}} · {{selfPlayer.classLabel}} · {{selfPlayer.faithLabel}}</text>
          </view>
          <view class="self-life">
            <text class="pill life-pill life-{{selfPlayer.lifeTone}}">{{selfPlayer.lifeLabel}}</text>
            <text class="pill">{{selfPlayer.lifeHint}}</text>
          </view>
        </view>

        <view class="ability-list">
          <view class="ability-card {{!selectedAbilityKey ? 'selected' : ''}}" bindtap="clearAbility">
            <text class="ability-name">普通行动</text>
            <text class="muted">不绑定职业技能或天赋，由 DM 结算。</text>
          </view>
          <view
            wx:for="{{selfPlayer.abilities}}"
            wx:key="key"
            class="ability-card {{item.key === selectedAbilityKey ? 'selected' : ''}} {{item.ready ? '' : 'disabled'}}"
            data-key="{{item.key}}"
            data-name="{{item.displayName}}"
            data-ready="{{item.ready ? '1' : '0'}}"
            bindtap="selectAbility"
          >
            <view class="row ability-head">
              <text class="ability-name">{{item.displayName}}</text>
              <text class="pill">{{item.cooldownLabel}}</text>
            </view>
            <text class="muted">{{item.detail}}</text>
          </view>
        </view>

        <view class="action-box action-shell">
          <view class="row action-shell-head">
            <text class="tool-title">本回合行动</text>
            <text class="tool-note">写清目标、方式、消耗和想要的结果。</text>
          </view>
          <text class="muted">当前选择：{{selectedAbilityName}}</text>
          <textarea class="textarea" value="{{actionText}}" maxlength="1200" placeholder="写下本回合行动，目标、方式、消耗和期望效果都放这里。" bindinput="onActionTextInput"></textarea>
          <button class="btn btn-primary" disabled="{{!canSubmitAction}}" loading="{{actionLoading}}" bindtap="submitAction">提交行动</button>
        </view>
      </block>
    </view>

    <view wx:if="{{!canManageBattle || activeDmPage === 'settle'}}" class="section panel battle-log-panel">
      <view class="row subhead">
        <text class="panel-title">{{actionListLabel}}</text>
        <text class="muted">{{visibleActionCountText}}</text>
      </view>
      <view wx:if="{{canOperate && !pendingActions.length}}" class="empty">暂无待处理行动。</view>
      <view wx:if="{{!canOperate && !selfActions.length}}" class="empty">你还没有提交过行动。</view>
      <view wx:for="{{visibleActions}}" wx:key="id" class="action-card action-stage">
        <view class="row action-head">
          <text class="action-title">{{item.actor_name}} · {{item.roundLabel}}</text>
          <text class="pill">{{item.statusLabel}}</text>
        </view>
        <text class="action-text">{{item.action_text}}</text>
        <text wx:if="{{item.cooldownLabel}}" class="muted">{{item.cooldownLabel}}</text>
        <text wx:if="{{item.hasDmNote}}" class="muted">DM：{{item.dm_note}}</text>
        <view wx:if="{{canOperate && item.action_status === 'submitted'}}" class="button-row action-tools">
          <button class="btn btn-primary" data-id="{{item.id}}" data-decision="resolved" loading="{{actionLoading}}" bindtap="resolveAction">结算</button>
          <button class="btn btn-danger" data-id="{{item.id}}" data-decision="dismissed" loading="{{actionLoading}}" bindtap="resolveAction">驳回</button>
        </view>
      </view>
    </view>

    <view wx:if="{{canManageBattle && activeDmPage !== 'field'}}" class="section panel dm-panel">
      <view class="row subhead dm-header">
        <view>
          <text class="panel-title">DM 操作台</text>
          <text class="muted">结算、状态、分队和房间收束都在这里处理。</text>
        </view>
        <text class="pill">主持模式</text>
      </view>

      <view wx:if="{{activeDmTool === 'settle'}}" class="dm-tool">
        <view class="tool-heading">
          <text class="tool-title">即时结算</text>
          <text class="tool-note">调整生命、护盾、备注或击倒。</text>
        </view>
        <view class="dm-grid">
          <picker mode="selector" range="{{players}}" range-key="player_name" bindchange="onDmTargetChange">
            <view class="input picker-input">目标：{{dmTargetPlayerId || '请选择'}}</view>
          </picker>
          <picker mode="selector" range="{{dmActionTypeLabels}}" bindchange="onDmActionTypeChange">
            <view class="input picker-input">操作：{{dmActionTypeLabel}}</view>
          </picker>
        </view>
        <input class="input" type="number" placeholder="数值" value="{{dmAmount}}" bindinput="onDmAmountInput" />
        <textarea class="textarea compact" value="{{dmNote}}" maxlength="500" placeholder="结算备注" bindinput="onDmNoteInput"></textarea>
        <button class="btn btn-primary" loading="{{actionLoading}}" bindtap="applyDmAction">应用到目标</button>
      </view>

      <view wx:if="{{activeDmTool === 'status'}}" class="dm-tool status-editor">
        <view class="tool-heading">
          <text class="tool-title">状态编辑</text>
          <text class="tool-note">层数为 0 时也保留，删除由 DM 决定。</text>
        </view>
        <picker mode="selector" range="{{players}}" range-key="player_name" bindchange="onStatusPlayerChange">
          <view class="input picker-input">玩家：{{statusPlayerName || '请选择'}}</view>
        </picker>
        <view class="status-form">
          <input class="input" placeholder="状态名字" value="{{statusName}}" bindinput="onStatusNameInput" />
          <input class="input status-count-input" type="number" placeholder="层数" value="{{statusStackCount}}" bindinput="onStatusStackInput" />
        </view>
        <view class="switch-row">
          <text class="muted">公开给所有人</text>
          <switch checked="{{statusIsPublic}}" bindchange="onStatusPublicChange" />
        </view>
        <button class="btn btn-primary" loading="{{actionLoading}}" bindtap="addStatus">添加状态</button>
      </view>

      <view wx:if="{{activeDmTool === 'room'}}" class="dm-tool round-tools">
        <view class="tool-heading round-heading">
          <text class="tool-title">回合推进</text>
          <text class="tool-note">需要跨回合时在这里调整。</text>
        </view>
        <input class="input round-input" type="number" value="{{roundInput}}" bindinput="onRoundInput" />
        <input class="input" placeholder="回合备注，可空" value="{{roundNote}}" bindinput="onRoundNoteInput" />
        <button class="btn btn-ghost" loading="{{actionLoading}}" bindtap="updateRound">推进/调整回合</button>
      </view>

      <view wx:if="{{activeDmTool === 'team'}}" class="dm-tool team-board">
        <view class="row subhead team-summary">
          <view>
            <text class="tool-title">房内组队</text>
            <text class="tool-note">红蓝两队不限制人数，未分配的人可保持观众。</text>
          </view>
          <view class="team-stats">
            <text class="tag team-tag team-red">红队 {{teamStats.red}}</text>
            <text class="tag team-tag team-blue">蓝队 {{teamStats.blue}}</text>
            <text class="tag team-tag team-spectator">观众 {{teamStats.spectator}}</text>
            <text class="tag team-tag team-custom">其他 {{teamStats.custom}}</text>
            <text class="tag">未分队 {{teamStats.unassigned}}</text>
          </view>
        </view>
        <view wx:for="{{players}}" wx:key="id" class="team-row">
          <view class="team-main">
            <view class="row team-head">
              <text class="team-name">{{item.player_name}}</text>
              <text class="pill team-pill team-{{item.teamKind}}">{{item.teamLabel}}</text>
            </view>
            <text class="muted">{{item.classLabel}} · {{item.faithLabel}} · {{item.statusLabel}}</text>
            <view class="team-presets">
              <button class="mini-action team-preset red" data-id="{{item.id}}" data-team="红队" loading="{{actionLoading}}" bindtap="setTeamPreset">红队</button>
              <button class="mini-action team-preset blue" data-id="{{item.id}}" data-team="蓝队" loading="{{actionLoading}}" bindtap="setTeamPreset">蓝队</button>
              <button class="mini-action team-preset gray" data-id="{{item.id}}" data-team="观众" loading="{{actionLoading}}" bindtap="setTeamPreset">观众</button>
            </view>
          </view>
          <view class="team-custom-box">
            <input class="input team-input" data-id="{{item.id}}" value="{{teamInputs[item.id]}}" placeholder="自定义队伍" bindinput="onTeamInput" />
            <button class="mini-action" data-id="{{item.id}}" loading="{{actionLoading}}" bindtap="updateTeam">保存</button>
          </view>
        </view>
      </view>

      <view wx:if="{{activeDmTool === 'room'}}" class="dm-tool danger-zone">
        <view class="tool-heading">
          <text class="tool-title">房间时间</text>
          <text class="tool-note">{{room.expiresNote}}</text>
        </view>
        <view class="button-row">
          <button wx:if="{{canExtend}}" class="btn btn-ghost" loading="{{actionLoading}}" bindtap="extendBattle">延长6小时</button>
          <button class="btn btn-ghost" data-status="finished" loading="{{actionLoading}}" bindtap="finishBattle">结束战斗</button>
          <button class="btn btn-danger" data-status="cancelled" loading="{{actionLoading}}" bindtap="finishBattle">取消战斗</button>
        </view>
      </view>
    </view>

    <view wx:if="{{canManageBattle}}" class="dm-navigation">
      <button class="dm-navigation-item {{activeDmPage === 'field' ? 'active' : ''}}" data-page="field" bindtap="setActiveDmPage">
        <text class="dm-navigation-icon">场</text>
        <text>战场</text>
      </button>
      <button class="dm-navigation-item {{activeDmPage === 'settle' ? 'active' : ''}}" data-page="settle" bindtap="setActiveDmPage">
        <text class="dm-navigation-icon">判</text>
        <text>结算</text>
      </button>
      <button class="dm-navigation-item {{activeDmPage === 'status' ? 'active' : ''}}" data-page="status" bindtap="setActiveDmPage">
        <text class="dm-navigation-icon">态</text>
        <text>状态</text>
      </button>
      <button class="dm-navigation-item {{activeDmPage === 'team' ? 'active' : ''}}" data-page="team" bindtap="setActiveDmPage">
        <text class="dm-navigation-icon">队</text>
        <text>分队</text>
      </button>
      <button class="dm-navigation-item {{activeDmPage === 'room' ? 'active' : ''}}" data-page="room" bindtap="setActiveDmPage">
        <text class="dm-navigation-icon">室</text>
        <text>房间</text>
      </button>
    </view>

    <view wx:if="{{!canManageBattle || activeDmPage === 'settle'}}" class="section panel battle-history-panel">
      <view class="row subhead">
        <text class="panel-title">公开战斗日志</text>
        <text class="muted">{{logs.length}} 条</text>
      </view>
      <view wx:if="{{!logs.length}}" class="empty">暂无日志。</view>
      <view wx:for="{{logs}}" wx:key="id" class="log-row">
        <text class="log-title">{{item.roundLabel}} · {{item.typeLabel}}{{item.targetLabel}}{{item.amountLabel}}</text>
        <text class="muted">{{item.actor_name || '系统'}} · {{item.timeLabel}}</text>
        <text wx:if="{{item.note}}" class="log-note">{{item.note}}</text>
      </view>
    </view>
  </block>
</view>
