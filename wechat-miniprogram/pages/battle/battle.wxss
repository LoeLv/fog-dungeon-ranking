.battle-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  background: #fff8ec;
}

.battle-topbar .title {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  line-height: 1.2;
}

.battle-topbar .muted {
  display: block;
  margin-top: 8rpx;
}

.hero-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
  flex-wrap: wrap;
}

.battle-overview {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.compact-overview {
  padding: 12rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  background: #f5ecdd;
}

.compact-overview .overview-card {
  padding: 12rpx;
  background: rgba(255, 253, 248, 0.86);
  box-shadow: none;
}

.compact-overview .overview-label {
  font-size: 19rpx;
}

.compact-overview .overview-value {
  margin-top: 5rpx;
  font-size: 24rpx;
}

.overview-card {
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.14);
  border-radius: 8rpx;
  background: linear-gradient(180deg, rgba(255, 250, 239, 0.96), rgba(249, 240, 220, 0.94));
  box-shadow: 0 8rpx 20rpx rgba(43, 28, 14, 0.06);
}

.overview-label {
  display: block;
  color: #856449;
  font-size: 22rpx;
  line-height: 1.3;
}

.overview-value {
  display: block;
  margin-top: 10rpx;
  color: #2c1a10;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.mini-action {
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(64, 41, 22, 0.22);
  border-radius: 8rpx;
  background: #fff9ef;
  color: #4b3020;
  font-size: 24rpx;
  line-height: 56rpx;
}

.panel-title {
  display: block;
  color: #2c1a10;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.subhead {
  margin-bottom: 16rpx;
}

.battle-player,
.action-card,
.ability-card,
.log-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(72, 45, 25, 0.1);
}

.team-section {
  display: grid;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.12);
  border-radius: 8rpx;
  background: #fffdf9;
}

.team-section:first-child {
  margin-top: 0;
}

.team-section.team-red {
  border-color: rgba(143, 45, 36, 0.14);
  background: linear-gradient(180deg, #fff7f6, #fffdf9);
}

.team-section.team-blue {
  border-color: rgba(39, 80, 130, 0.14);
  background: linear-gradient(180deg, #f6f9ff, #fffdf9);
}

.team-section.team-spectator,
.team-section.team-custom,
.team-section.team-unassigned {
  background: #fffdf7;
}

.team-section-head {
  align-items: center;
  min-height: 56rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(72, 45, 25, 0.08);
}

.team-section-title {
  color: #2c1a10;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.empty.compact {
  padding: 18rpx 16rpx;
  font-size: 23rpx;
}

.battle-player:last-child,
.action-card:last-child,
.ability-card:last-child,
.log-row:last-child {
  border-bottom: 0;
}

.battle-panel {
  display: grid;
  gap: 14rpx;
}

.battlefield-panel {
  padding: 18rpx;
  background: #fffaf0;
}

.battlefield-panel > .subhead {
  display: none;
}

.battlefield-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(72, 45, 25, 0.12);
}

.battlefield-heading .panel-title {
  margin-top: 4rpx;
  font-size: 36rpx;
}

.battlefield-heading .muted {
  display: block;
  margin-top: 6rpx;
}

.field-counters {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.field-counter {
  min-height: 42rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(122, 59, 22, 0.18);
  border-radius: 999rpx;
  background: #f5e6cc;
  color: #7a3b16;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.battle-core {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.battle-mode-player .battlefield-core {
  align-items: start;
  gap: 18rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.battle-mode-player .team-section {
  min-width: 0;
  padding: 18rpx;
  box-shadow: 0 8rpx 18rpx rgba(43, 28, 14, 0.06);
}

.battle-mode-player .battle-player.self {
  border-width: 2rpx;
  box-shadow: 0 8rpx 18rpx rgba(122, 59, 22, 0.1);
}

.battle-mode-player .player-action-panel {
  border-color: rgba(122, 59, 22, 0.28);
  background: #fff4dc;
}

.battle-mode-player .battle-log-panel {
  background: #fffdf8;
}

.battle-mode-player .battlefield-panel {
  background: radial-gradient(circle at top, #fff8ef 0%, #fff4e3 100%);
}

.battle-mode-player .crowd-strip {
  box-shadow: inset 0 0 0 1rpx rgba(122, 59, 22, 0.04);
}

.battle-mode-player .team-section {
  min-width: 0;
  box-shadow: 0 10rpx 22rpx rgba(43, 28, 14, 0.05);
}

.battle-mode-player .player-action-panel .self-banner {
  border-color: rgba(122, 59, 22, 0.22);
  background: linear-gradient(180deg, #fff4e2, #fffaf0);
}

.battle-mode-player .player-action-panel .ability-card {
  border-color: rgba(72, 45, 25, 0.18);
}

.battle-mode-player .player-action-panel .action-shell {
  background: linear-gradient(180deg, #fff5e4, #fffaf3);
}

.crowd-strip {
  display: grid;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx dashed rgba(122, 59, 22, 0.16);
  border-radius: 8rpx;
  background: #fffdf7;
}

.crowd-top,
.crowd-bottom {
  margin: 2rpx 0;
}

.crowd-label {
  color: #8b5a25;
  font-size: 22rpx;
  font-weight: 700;
}

.crowd-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.crowd-chip {
  min-height: 42rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(91, 60, 31, 0.14);
  border-radius: 999rpx;
  background: #f6ede0;
  color: #5d3b22;
  font-size: 22rpx;
  line-height: 40rpx;
}

.reserve-strip {
  display: grid;
  gap: 12rpx;
}

.reserve-group {
  display: grid;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.1);
  border-radius: 8rpx;
  background: #fffdf8;
}

.reserve-chip {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f0e6d8;
  color: #5d3b22;
  font-size: 22rpx;
  line-height: 40rpx;
}

.battle-player.self {
  padding: 18rpx;
  border: 1rpx solid rgba(122, 59, 22, 0.2);
  border-radius: 8rpx;
  background: #fff5e2;
}

.player-head {
  align-items: flex-start;
}

.player-head-meta {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.player-name,
.action-title,
.log-title,
.ability-name {
  display: block;
  color: #2c1a10;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hp-track {
  overflow: hidden;
  width: 100%;
  height: 16rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #ead9c2;
}

.hp-fill {
  height: 100%;
  border-radius: inherit;
  background: #8f2d24;
}

.hp-fill.hp-high {
  background: #3d8b58;
}

.hp-fill.hp-mid {
  background: #c58a2c;
}

.hp-fill.hp-low,
.hp-fill.hp-down {
  background: #a6372f;
}

.hp-fill.hp-high {
  background: #3d8b58;
}

.hp-fill.hp-mid {
  background: #c58a2c;
}

.hp-fill.hp-low,
.hp-fill.hp-down {
  background: #a6372f;
}

.hp-pill.hp-high {
  background: #f4ead8;
  color: #4e3a24;
}

.hp-pill.hp-mid {
  background: #f2ddb8;
  color: #7a4a18;
}

.hp-pill.hp-low {
  background: #f5d4d0;
  color: #8f2d24;
}

.hp-pill.hp-down {
  background: #e5ded4;
  color: #65584a;
}

.life-pill {
  min-height: 40rpx;
  font-size: 20rpx;
  line-height: 38rpx;
}

.life-pill.life-alive {
  background: #f3ead8;
  color: #4e3a24;
}

.life-pill.life-dead {
  border-color: rgba(143, 45, 36, 0.28);
  background: #8f2d24;
  color: #fff;
}

.public-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.team-tag {
  font-weight: 700;
}

.team-red,
.team-pill.team-red {
  background: #f5d4d0;
  color: #8f2d24;
}

.team-blue,
.team-pill.team-blue {
  background: #d6e4f6;
  color: #275082;
}

.team-spectator,
.team-pill.team-spectator {
  background: #e8e4dd;
  color: #5f5247;
}

.team-custom,
.team-pill.team-custom {
  background: #efe1c8;
  color: #7a4a18;
}

.team-unassigned,
.team-pill.team-unassigned {
  background: #ebe1d2;
  color: #6a5a4a;
}

.status-list {
  display: grid;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-empty {
  color: #8a7664;
  font-size: 23rpx;
}

.status-chip {
  display: grid;
  gap: 10rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(93, 59, 34, 0.16);
  border-radius: 8rpx;
  background: #fff8ea;
}

.status-chip.private {
  background: #f1eadf;
}

.status-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.status-name {
  color: #2c1a10;
  font-size: 25rpx;
  font-weight: 700;
}

.status-meta {
  color: #755f4d;
  font-size: 22rpx;
}

.status-tools {
  display: grid;
  grid-template-columns: 110rpx repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.status-layer-input,
.status-count-input {
  height: 58rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
}

.status-button {
  min-width: 0;
  padding: 0 10rpx;
}

.status-button.danger {
  border-color: rgba(143, 45, 36, 0.32);
  color: #8f2d24;
}

.public-abilities {
  display: grid;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ability-fold-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.14);
  border-radius: 8rpx;
  background: #f5ead8;
}

.ability-fold-title {
  color: #4f3320;
  font-size: 24rpx;
  font-weight: 700;
}

.ability-fold-action {
  color: #8a4d24;
  font-size: 22rpx;
  font-weight: 700;
}

.ability-fold-body {
  display: grid;
  gap: 10rpx;
}

.ability-fold-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.14);
  border-radius: 8rpx;
  background: #f5ead8;
}

.ability-fold-title {
  color: #4f3320;
  font-size: 24rpx;
  font-weight: 700;
}

.ability-fold-action {
  color: #8a4d24;
  font-size: 22rpx;
  font-weight: 700;
}

.ability-fold-body {
  display: grid;
  gap: 10rpx;
}

.public-ability {
  padding: 14rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.14);
  border-radius: 8rpx;
  background: #fffdf7;
}

.public-ability.disabled {
  background: #f3eadc;
}

.ability-side {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
}

.cooldown-button {
  min-width: 88rpx;
}

.tag {
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f4e4cf;
  color: #5d3b22;
  font-size: 22rpx;
  line-height: 42rpx;
}

.player-note,
.log-note {
  display: block;
  margin-top: 10rpx;
}

.self-summary {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.self-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(122, 59, 22, 0.14);
  border-radius: 8rpx;
  background: #fff7ea;
}

.self-life {
  display: flex;
  flex: 0 0 auto;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.self-stat {
  color: #7a3b16;
  font-size: 38rpx;
  font-weight: 800;
}

.ability-list {
  display: grid;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.ability-card {
  padding: 18rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.16);
  border-radius: 8rpx;
  background: #fffdf7;
}

.ability-card.selected {
  border-color: rgba(122, 59, 22, 0.55);
  background: #fff1d8;
}

.ability-card.disabled {
  opacity: 0.62;
}

.ability-head {
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.action-box {
  display: grid;
  gap: 14rpx;
}

.action-shell {
  padding: 18rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.14);
  border-radius: 8rpx;
  background: #fffaf1;
}

.action-shell-head {
  align-items: flex-start;
}

.action-stage {
  padding: 16rpx 0;
}

.textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(54, 35, 20, 0.24);
  border-radius: 8rpx;
  background: #fffdf7;
  color: #24180f;
  font-size: 28rpx;
  line-height: 1.5;
}

.textarea.compact {
  min-height: 112rpx;
  margin-top: 14rpx;
}

.action-text {
  display: block;
  margin: 12rpx 0;
  color: #352214;
  font-size: 26rpx;
  line-height: 1.55;
}

.action-tools {
  margin-top: 14rpx;
}

.dm-panel {
  display: grid;
  gap: 14rpx;
}

.dm-tabs {
  display: flex;
  overflow-x: auto;
  gap: 10rpx;
  padding-bottom: 4rpx;
}

.dm-tab {
  flex: 0 0 150rpx;
  min-width: 150rpx;
  height: 62rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.16);
  border-radius: 8rpx;
  background: #fff7ea;
  color: #5c4028;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.dm-tab.active {
  border-color: rgba(122, 59, 22, 0.42);
  background: #7a3b16;
  color: #fff;
}

.dm-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.small-title {
  font-size: 26rpx;
}

.dm-header {
  align-items: flex-start;
}

.dm-tool {
  display: grid;
  gap: 14rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.12);
  border-radius: 8rpx;
  background: #fffdf7;
}

.tool-heading {
  display: grid;
  gap: 4rpx;
}

.tool-title {
  color: #2c1a10;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.tool-note {
  color: #7a6757;
  font-size: 22rpx;
  line-height: 1.45;
}

.status-editor {
  gap: 14rpx;
}

.status-form {
  display: grid;
  grid-template-columns: 1fr 140rpx;
  gap: 14rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-input {
  line-height: 86rpx;
}

.round-tools {
  display: grid;
  grid-template-columns: 150rpx 1fr;
  gap: 14rpx;
}

.round-heading {
  grid-column: 1 / -1;
}

.round-tools button {
  grid-column: 1 / -1;
}

.team-list {
  display: grid;
  gap: 12rpx;
}

.team-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  align-items: start;
  padding: 16rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.12);
  border-radius: 8rpx;
  background: #fffdf7;
}

.team-main {
  display: grid;
  gap: 12rpx;
  min-width: 0;
}

.team-head {
  align-items: center;
}

.team-name {
  color: #2c1a10;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.team-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.team-preset {
  min-width: 92rpx;
  height: 52rpx;
  padding: 0 14rpx;
  line-height: 50rpx;
}

.team-preset.red {
  border-color: rgba(143, 45, 36, 0.24);
  background: #f8e0dd;
  color: #8f2d24;
}

.team-preset.blue {
  border-color: rgba(39, 80, 130, 0.24);
  background: #e2ebf7;
  color: #275082;
}

.team-preset.gray {
  border-color: rgba(95, 82, 71, 0.2);
  background: #ede8e2;
  color: #5f5247;
}

.team-custom-box {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 132rpx;
  gap: 10rpx;
}

.team-input {
  height: 62rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
}

.team-board {
  gap: 14rpx;
}

.team-summary {
  align-items: flex-start;
  gap: 12rpx;
}

.danger-zone {
  border-color: rgba(143, 45, 36, 0.16);
  background: #fff8f4;
}

.team-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
}

.log-row {
  display: grid;
  gap: 6rpx;
}

.error {
  border-color: rgba(143, 45, 36, 0.28);
  color: #8f2d24;
}

.battle-page {
  position: relative;
  overflow-x: hidden;
  padding-bottom: 132rpx;
}

.battle-mode-player {
  background:
    radial-gradient(circle at 50% 0, rgba(255, 249, 228, 0.96), rgba(247, 241, 230, 0) 38%),
    linear-gradient(180deg, #f7f1e6 0%, #efe5d2 100%);
}

.battle-mode-player .battle-topbar {
  position: relative;
  overflow: hidden;
  border-color: rgba(122, 59, 22, 0.28);
  background:
    linear-gradient(135deg, rgba(44, 26, 16, 0.96), rgba(92, 47, 25, 0.96)),
    #2c1a10;
  color: #fff8ec;
  box-shadow: 0 14rpx 30rpx rgba(43, 28, 14, 0.18);
}

.battle-mode-player .battle-topbar::after {
  position: absolute;
  right: -90rpx;
  bottom: -120rpx;
  width: 300rpx;
  height: 300rpx;
  border: 1rpx solid rgba(255, 236, 193, 0.2);
  border-radius: 50%;
  box-shadow: 0 0 0 24rpx rgba(255, 236, 193, 0.04), 0 0 0 48rpx rgba(255, 236, 193, 0.03);
  content: "";
}

.battle-mode-player .battle-topbar .title,
.battle-mode-player .battle-topbar .panel-title {
  color: #fff8ec;
}

.battle-mode-player .battle-topbar .kicker {
  color: #f0c66d;
}

.battle-mode-player .battle-topbar .muted {
  color: rgba(255, 248, 236, 0.72);
}

.battle-mode-player .battlefield-panel {
  border-color: rgba(122, 59, 22, 0.22);
  box-shadow: 0 14rpx 34rpx rgba(43, 28, 14, 0.12);
}

.battle-mode-player .battlefield-core {
  position: relative;
  padding: 8rpx 0 4rpx;
}

.battle-mode-player .battlefield-core::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 2rpx;
  height: 76%;
  background: linear-gradient(180deg, transparent, rgba(122, 59, 22, 0.16), transparent);
  content: "";
}

.battle-mode-player .team-section-title {
  letter-spacing: 2rpx;
}

.battle-mode-player .team-section.team-red {
  border-width: 2rpx;
  border-color: rgba(143, 45, 36, 0.34);
  box-shadow: inset 0 8rpx 0 rgba(143, 45, 36, 0.06);
}

.battle-mode-player .team-section.team-blue {
  border-width: 2rpx;
  border-color: rgba(39, 80, 130, 0.34);
  box-shadow: inset 0 8rpx 0 rgba(39, 80, 130, 0.06);
}

.battle-mode-player .battle-player {
  padding: 20rpx 4rpx;
}

.battle-mode-player .battle-player.self {
  padding: 18rpx;
  border-color: rgba(122, 59, 22, 0.42);
  background: #fff1d8;
}

.battle-mode-player .player-name {
  font-size: 30rpx;
}

.battle-mode-player .hp-track {
  height: 20rpx;
  margin-top: 16rpx;
  box-shadow: inset 0 0 0 1rpx rgba(43, 28, 14, 0.08);
}

.battle-mode-player .crowd-strip {
  border-style: solid;
  border-color: rgba(122, 59, 22, 0.18);
  background: rgba(255, 253, 247, 0.72);
}

.battle-mode-dm {
  padding-bottom: 154rpx;
}

.battle-mode-dm .battlefield-panel {
  margin-bottom: 0;
}

.dm-navigation {
  position: fixed;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 6rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 249, 239, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(43, 28, 14, 0.2);
  backdrop-filter: blur(16rpx);
}

.dm-navigation-item {
  display: flex;
  min-width: 0;
  min-height: 78rpx;
  padding: 8rpx 4rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 12rpx;
  background: transparent;
  color: #765c42;
  font-size: 20rpx;
  line-height: 1.2;
}

.dm-navigation-item::after {
  border: 0;
}

.dm-navigation-item.active {
  background: #7a3b16;
  color: #fff8ec;
  box-shadow: 0 6rpx 14rpx rgba(122, 59, 22, 0.22);
}

.dm-navigation-icon {
  display: block;
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.battle-mode-dm.field .battlefield-panel {
  min-height: 60vh;
}

.battle-mode-dm.settle .battle-log-panel,
.battle-mode-dm.settle .battle-history-panel {
  display: block;
}

.battle-mode-dm.status .dm-panel,
.battle-mode-dm.team .dm-panel,
.battle-mode-dm.room .dm-panel {
  min-height: 56vh;
}

@media screen and (max-width: 420px) {
  .battle-topbar,
  .dm-grid,
  .round-tools,
  .battle-overview,
  .battle-core {
    grid-template-columns: 1fr;
  }

  .battle-topbar {
    display: grid;
  }

  .battlefield-heading {
    display: grid;
  }

  .field-counters {
    justify-content: flex-start;
  }

  .compact-overview {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .self-banner {
    align-items: flex-start;
    flex-direction: column;
  }

  .hero-actions {
    width: 100%;
  }

  .hero-actions button {
    flex: 1;
  }

  .battle-panel,
  .reserve-strip {
    gap: 12rpx;
  }

  .crowd-list,
  .team-presets {
    gap: 8rpx;
  }

  .crowd-chip,
  .reserve-chip {
    font-size: 20rpx;
  }

  .dm-tabs {
    justify-content: flex-start;
  }

  .dm-tab {
    flex: 0 0 150rpx;
  }

  .status-tools {
    grid-template-columns: 100rpx repeat(3, minmax(0, 1fr));
  }

  .battle-mode-player .battlefield-core {
    grid-template-columns: 1fr;
  }

  .battle-mode-player .battlefield-core::before {
    display: none;
  }

  .dm-navigation {
    right: 12rpx;
    bottom: 12rpx;
    left: 12rpx;
  }

  .dm-navigation-item {
    min-height: 72rpx;
    font-size: 19rpx;
  }
}
