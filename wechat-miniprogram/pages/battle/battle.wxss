.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  background: #fff8ec;
}

.hero-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mini-action {
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(64, 41, 22, 0.22);
  border-radius: 8rpx;
  background: #fff9ef;
  color: #4b3020;
  font-size: 24rpx;
  line-height: 56rpx;
}

.panel-title {
  display: block;
  color: #2c1a10;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.subhead {
  margin-bottom: 16rpx;
}

.battle-player,
.action-card,
.ability-card,
.log-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(72, 45, 25, 0.1);
}

.battle-player:last-child,
.action-card:last-child,
.ability-card:last-child,
.log-row:last-child {
  border-bottom: 0;
}

.battle-player.self {
  padding: 18rpx;
  border: 1rpx solid rgba(122, 59, 22, 0.2);
  border-radius: 8rpx;
  background: #fff5e2;
}

.player-head {
  align-items: flex-start;
}

.player-name,
.action-title,
.log-title,
.ability-name {
  display: block;
  color: #2c1a10;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hp-track {
  overflow: hidden;
  width: 100%;
  height: 16rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #ead9c2;
}

.hp-fill {
  height: 100%;
  border-radius: inherit;
  background: #8f2d24;
}

.public-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-list {
  display: grid;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-empty {
  color: #8a7664;
  font-size: 23rpx;
}

.status-chip {
  display: grid;
  gap: 10rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(93, 59, 34, 0.16);
  border-radius: 8rpx;
  background: #fff8ea;
}

.status-chip.private {
  background: #f1eadf;
}

.status-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.status-name {
  color: #2c1a10;
  font-size: 25rpx;
  font-weight: 700;
}

.status-meta {
  color: #755f4d;
  font-size: 22rpx;
}

.status-tools {
  display: grid;
  grid-template-columns: 110rpx repeat(3, 1fr);
  gap: 10rpx;
}

.status-layer-input,
.status-count-input {
  height: 58rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
}

.status-button {
  min-width: 0;
  padding: 0 10rpx;
}

.status-button.danger {
  border-color: rgba(143, 45, 36, 0.32);
  color: #8f2d24;
}

.public-abilities {
  display: grid;
  gap: 10rpx;
  margin-top: 16rpx;
}

.public-ability {
  padding: 14rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.14);
  border-radius: 8rpx;
  background: #fffdf7;
}

.public-ability.disabled {
  background: #f3eadc;
}

.ability-side {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
}

.cooldown-button {
  min-width: 88rpx;
}

.tag {
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f4e4cf;
  color: #5d3b22;
  font-size: 22rpx;
  line-height: 42rpx;
}

.player-note,
.log-note {
  display: block;
  margin-top: 10rpx;
}

.self-summary {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.self-stat {
  color: #7a3b16;
  font-size: 38rpx;
  font-weight: 800;
}

.ability-list {
  display: grid;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.ability-card {
  padding: 18rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.16);
  border-radius: 8rpx;
  background: #fffdf7;
}

.ability-card.selected {
  border-color: rgba(122, 59, 22, 0.55);
  background: #fff1d8;
}

.ability-card.disabled {
  opacity: 0.62;
}

.ability-head {
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.action-box {
  display: grid;
  gap: 14rpx;
}

.textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(54, 35, 20, 0.24);
  border-radius: 8rpx;
  background: #fffdf7;
  color: #24180f;
  font-size: 28rpx;
  line-height: 1.5;
}

.textarea.compact {
  min-height: 112rpx;
  margin-top: 14rpx;
}

.action-text {
  display: block;
  margin: 12rpx 0;
  color: #352214;
  font-size: 26rpx;
  line-height: 1.55;
}

.action-tools {
  margin-top: 14rpx;
}

.dm-panel {
  display: grid;
  gap: 16rpx;
}

.dm-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.small-title {
  font-size: 26rpx;
}

.status-editor {
  display: grid;
  gap: 14rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(72, 45, 25, 0.14);
  border-radius: 8rpx;
  background: #fffdf7;
}

.status-form {
  display: grid;
  grid-template-columns: 1fr 140rpx;
  gap: 14rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-input {
  line-height: 86rpx;
}

.round-tools {
  display: grid;
  grid-template-columns: 150rpx 1fr;
  gap: 14rpx;
}

.round-tools button {
  grid-column: 1 / -1;
}

.team-list {
  display: grid;
  gap: 12rpx;
}

.team-row {
  display: grid;
  grid-template-columns: 1fr 120rpx 112rpx;
  align-items: center;
  gap: 12rpx;
  color: #2b1c12;
  font-size: 26rpx;
}

.team-input {
  height: 62rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
}

.log-row {
  display: grid;
  gap: 6rpx;
}

.error {
  border-color: rgba(143, 45, 36, 0.28);
  color: #8f2d24;
}

@media screen and (max-width: 420px) {
  .hero,
  .dm-grid,
  .round-tools {
    grid-template-columns: 1fr;
  }

  .hero {
    display: grid;
  }

  .hero-actions {
    width: 100%;
  }

  .hero-actions button {
    flex: 1;
  }
}
