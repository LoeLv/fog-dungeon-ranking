.hero {
  padding: 18rpx 2rpx 6rpx;
}

.hero-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 0;
  padding: 22rpx;
  border: 1rpx solid rgba(84, 51, 25, 0.18);
  border-radius: 8rpx;
  background: #fff9ee;
  box-shadow: 0 10rpx 28rpx rgba(43, 28, 14, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero .title {
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.hero-summary {
  display: block;
  margin-top: 8rpx;
}

.hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.hero-chip {
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(122, 59, 22, 0.1);
  color: #704615;
  font-size: 22rpx;
  line-height: 40rpx;
}

.hero-aside {
  flex: 0 0 132rpx;
  padding: 16rpx 14rpx;
  border-radius: 8rpx;
  background: #2b1d14;
  text-align: center;
}

.hero-aside-label {
  display: block;
  color: #d9b889;
  font-size: 22rpx;
  line-height: 1.3;
}

.hero-aside-value {
  display: block;
  margin-top: 8rpx;
  color: #fff5df;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.1;
}

.panel-title {
  display: block;
  color: #2c1a10;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.mini-action {
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(64, 41, 22, 0.22);
  border-radius: 8rpx;
  background: #fff9ef;
  color: #4b3020;
  font-size: 24rpx;
  line-height: 56rpx;
}

.state-head {
  align-items: flex-start;
}

.duration-line {
  display: block;
  margin-top: 8rpx;
}

.duration-hint {
  display: block;
  margin-top: 12rpx;
}

.one-shot-note {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 8rpx;
  background: #f7dfc0;
  color: #69351b;
  font-size: 24rpx;
  line-height: 1.55;
}

.room-input {
  margin-top: 18rpx;
}

.search-panel {
  background: #fffaf0;
}

.search-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.search-input {
  flex: 1;
}

.search-button {
  min-width: 128rpx;
}

.search-note {
  display: block;
  margin-top: 14rpx;
}

.player-list {
  display: grid;
  gap: 16rpx;
}

.player-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.player-name {
  display: block;
  color: #2c1a10;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.required-note {
  display: block;
  margin-top: 4rpx;
}

.subhead {
  margin-bottom: 16rpx;
}

.queue-empty {
  margin-top: 8rpx;
}

.player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 68rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(72, 45, 25, 0.1);
  color: #2b1c12;
  font-size: 26rpx;
}

.player-row:last-child {
  border-bottom: 0;
}

.remove-button {
  min-width: 98rpx;
}

.start-button {
  width: 100%;
  margin-bottom: 24rpx;
}

@media screen and (max-width: 420px) {
  .hero-card {
    flex-direction: column;
  }

  .hero-aside {
    width: 100%;
    flex-basis: auto;
    text-align: left;
  }
}
