.profile-hero {
  padding: 18rpx 4rpx 12rpx;
}

.hero-mark {
  display: inline-block;
  margin-bottom: 18rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(125, 74, 31, 0.24);
  border-radius: 999rpx;
  background: #fff0d1;
  color: #7a3b16;
  font-size: 22rpx;
  font-weight: 700;
}

.profile-hero .title {
  font-size: 48rpx;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.score-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.score-card {
  min-height: 156rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(91, 60, 31, 0.18);
  border-radius: 8rpx;
  background: #2b1d14;
  box-shadow: 0 12rpx 28rpx rgba(43, 28, 14, 0.14);
}

.score-label {
  display: block;
  color: #d9b889;
  font-size: 23rpx;
}

.score-value {
  display: block;
  margin-top: 16rpx;
  color: #fff5df;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 64rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(72, 45, 25, 0.1);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  color: #806c58;
  font-size: 25rpx;
}

.detail-value {
  max-width: 68%;
  color: #2c1a10;
  font-size: 26rpx;
  font-weight: 700;
  text-align: right;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.honor-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.title-tag {
  background: #f3dfad;
  color: #704615;
}

.curse-line {
  margin-top: 16rpx;
}

.curse-tag {
  background: #ead1cf;
  color: #7b2f28;
}

.curse-empty {
  display: block;
  margin-top: 16rpx;
}

.record-text {
  display: block;
  color: #3a291d;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

.updated-note {
  padding: 4rpx 8rpx 18rpx;
  color: #806c58;
  font-size: 22rpx;
  text-align: right;
}

.profile-actions {
  padding-bottom: 24rpx;
}

.error-panel {
  background: #fff4ed;
}
